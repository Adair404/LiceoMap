# Valores del servidor local preoficial. Todas estas variables son configurables.
# Para una instalación upstream existente: DB_PORT=3306 y DB_NAME=colegio_db.
# No ejecutar seeds ni migraciones históricas sobre una base existente.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=liceomap_preoficial_dev
DB_USER=liceomap_app
DB_PASSWORD=cambiar
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio
JWT_EXPIRE_MINUTES=60
# Si el cliente se sirve desde otro origen, añadirlo explícitamente a esta lista.
# /test se sirve desde la propia API en :8000 y no necesita un origen CORS adicional.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
